-# frozen_string_literal: true

#help-modal.modal
  #help-dialog.modal-dialog{role: "dialog", "aria-labelledby": "help-title", "aria-modal": "true"}
    .modal-content
      .modal-header.ps-5
        %button.close{ type: "button", data: { "bs-dismiss": "modal"}, aria: {hidden: "true"}}
          &times;
          #help-title
        %h2.modal-title
          Help and suggestions
      .modal-body.px-5
        %h3 Troubleshooting guide
        %p
          See the
          %a.trouble-shooting{href: "https://www.gov.uk/about-the-price-paid-data#price-paid-data-report-builder"} troubleshooting guide
          for answers to commonly encountered difficulties in using this
          dataset.
        %h3 Tips
        %dl.dl-horizontal
          -# %dt
          -#   %i.fa.fa-print
          -# %dd
          -#   Click the print button for a view of the data optimised for printing
          %dt
            %i.fa.fa-share-square-o
          %dd
            Use this button to create a link to your results that you can bookmark,
            copy into email or share by social media sites
          %dt
            %i.fa.fa-times-circle
          %dd
            Remove a search term from the current search
          %dt
            %i.fa.fa-search-plus
          %dd
            Add a term to refine the current search

        %h3 Further help and feedback
        %p
          If you have additional questions, or you have feedback on this beta service,
          please email
          %span.email-address= mail_to(Rails.application.config.contact_email_address)

      .modal-footer.px-5
        .footer-row
          %button.btn.btn-outline-secondary{ type: "button", data: { "bs-dismiss": "modal"} }
            OK
