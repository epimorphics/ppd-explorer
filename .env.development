#* For information on how to running a proxy to mimic production and run multple
#* services together check the simple-web-proxy repository:
#* https://github.com/epimorphics/simple-web-proxy/

#? This should point to the local instance of the API running in Docker;
#? Further details can be found in the WIKI documentation:
#? https://github.com/epimorphics/ppd-explorer/wiki
# API_SERVICE_URL=http://localhost:8888

#? This is the LOCAL metrics port which allows multiple LR Apps to run on the same machine
METRICS_PORT=9394
#? This is the LOCAL port which allows multiple LR Apps to run on the same machine
PORT=3001

#? These set additional functionality or tags in the Sentry UI
SENTRY_BAND='dev'
SENTRY_ENABLED=false
SENTRY_ENVIRONMENT='development'
SENTRY_HOSTNAME='localhost'
